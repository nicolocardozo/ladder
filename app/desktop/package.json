{
  "name": "@ladder/desktop",
  "version": "0.1.5",
  "private": true,
  "license": "Apache-2.0",
  "description": "Ladder: a macOS workspace for coding agents",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "test:remote": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"src/shared/*.test.ts\" \"src/shared/remote/*.test.ts\" \"src/host/remote/*.test.ts\" \"src/main/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "postinstall": "node scripts/postinstall.mjs",
    "dist": "electron-vite build && node scripts/third-party-notices.mjs && electron-builder --mac --dir",
    "release:mac": "node scripts/release-mac.mjs",
    "sync-brand": "node scripts/sync-brand.mjs",
    "ladder": "node --no-warnings src/cli/main.ts",
    "test:cli": "node --no-warnings scripts/cli.test.mts"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.319",
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/mona-sans": "5.3.0",
    "@fontsource/monaspace-neon": "5.3.0",
    "@lobehub/icons-static-svg": "1.102.0",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/react-virtual": "3.14.26",
    "@types/node": "26.6.6",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.2.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/headless": "6.0.0",
    "@xterm/xterm": "6.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "electron-updater": "6.8.11",
    "electron-vite": "6.0.0",
    "lucide-react": "1.70.0",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "shadcn": "^4.23.0",
    "shiki": "4.6.0",
    "smol-toml": "1.9.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "zustand": "5.0.16"
  },
  "productName": "Ladder",
  "dependencies": {
    "@agentclientprotocol/sdk": "2.4.0",
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/merge": "^6.12.3",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@noble/ciphers": "2.4.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "node-pty": "1.1.0",
    "ws": "8.23.0",
    "zod": "4.6.7"
  },
  "optionalDependencies": {
    "@anthropic-ai/claude-agent-sdk-darwin-arm64": "0.3.319",
    "@anthropic-ai/claude-agent-sdk-darwin-x64": "0.3.319"
  }
}

{
  "expo": {
    "name": "Ladder",
    "slug": "ladder",
    "owner": "manybitstech",
    "scheme": "ladder",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "dev.nicolocardozo.ladder.mobile",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": true,
        "NSCameraUsageDescription": "Ladder uses the camera to scan the pairing code shown on your Mac.",
        "UIViewControllerBasedStatusBarAppearance": false
      },
      "icon": {
        "light": "./assets/icon.png",
        "dark": "./assets/icon-dark.png",
        "tinted": "./assets/icon-tinted.png"
      }
    },
    "android": {
      "package": "dev.nicolocardozo.ladder.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#22123C"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.VIBRATE"
      ],
      "allowBackup": false
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-localization",
      "expo-asset",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#5525CF",
          "defaultChannel": "sessions"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Ladder uses the camera to scan the pairing code shown on your Mac.",
          "recordAudioAndroid": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "dark": {
            "backgroundColor": "#181424"
          }
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "eas": {
        "projectId": "44500324-7107-4791-b174-be05b5af0325"
      }
    }
  }
}

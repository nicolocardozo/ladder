{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "noUnusedLocals": true,
    "paths": {
      "@/*": ["./src/*"],
      "@shared/*": ["../desktop/src/shared/*"]
    }
  },
  "include": ["app", "src", "global.d.ts", "../desktop/src/shared/**/*.ts"],
  "exclude": ["../desktop/src/shared/**/*.test.ts", "src/**/*.test.ts"]
}

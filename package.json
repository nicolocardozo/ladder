{
  "name": "ladder",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "pnpm --filter @ladder/desktop dev",
    "build": "pnpm --filter @ladder/desktop build",
    "typecheck": "pnpm -r typecheck",
    "dev:web": "pnpm --filter @ladder/website dev",
    "build:web": "pnpm --filter @ladder/website build"
  }
}

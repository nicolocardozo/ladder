{
  "name": "@ladder/desktop",
  "version": "0.0.0",
  "private": true,
  "description": "Ladder: workspace macOS per agenti di sviluppo",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite",
    "build": "electron-vite build",
    "start": "electron-vite preview",
